#!/usr/bin/env bash
set -euo pipefail

# One-time human installation. Run from this checkout:
#   cd /home/kyle/fpl && sudo ./bin/install-preseason-broker

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run with sudo: sudo ./bin/install-preseason-broker" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
EXPECTED_ROOT="/home/kyle/fpl"
[[ "$PROJECT_ROOT" == "$EXPECTED_ROOT" ]] || {
  echo "Install this broker from $EXPECTED_ROOT; refusing another project path." >&2
  exit 1
}

AGENT_USER="${SUDO_USER:-${DEFAULT_AGENT_USER:-kyle}}"
[[ "$AGENT_USER" != root ]] || {
  echo "Set DEFAULT_AGENT_USER to the non-root FPL user when installing as root." >&2
  exit 1
}
getent passwd "$AGENT_USER" >/dev/null || {
  echo "FPL agent user does not exist: $AGENT_USER" >&2
  exit 1
}

SOURCE_IMPORTER="$PROJECT_ROOT/scripts/fetch-preseason-data.mjs"
SOURCE_BROKER="$SCRIPT_DIR/fpl-preseason-broker"
SOURCE_WRAPPER="$SCRIPT_DIR/fpl-preseason-wrapper"
NODE="/usr/bin/node"
LIBEXEC_DIR="/usr/local/libexec/fpl-preseason"
INSTALLER_BROKER="$LIBEXEC_DIR/fpl-preseason-broker"
INSTALLER_IMPORTER="$LIBEXEC_DIR/fetch-preseason-data.mjs"
WRAPPER="/usr/local/bin/fpl-fetch-preseason-data"
CACHE_DIR="/var/cache/fpl-preseason-api"
RUN_HOME="/var/lib/fpl-preseason"
SUDOERS_FILE="/etc/sudoers.d/fpl-preseason-broker"

[[ -f "$SOURCE_IMPORTER" && ! -L "$SOURCE_IMPORTER" ]] || { echo "Importer source is missing or symlinked." >&2; exit 1; }
[[ -f "$SOURCE_BROKER" && ! -L "$SOURCE_BROKER" ]] || { echo "Broker source is missing or symlinked." >&2; exit 1; }
[[ -f "$SOURCE_WRAPPER" && ! -L "$SOURCE_WRAPPER" ]] || { echo "Wrapper source is missing or symlinked." >&2; exit 1; }

require_root_directory() {
  local path="$1"
  python3 - "$path" <<'PY'
import os
import stat
import sys

path = sys.argv[1]
st = os.lstat(path)
if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
    raise SystemExit(f"Unsafe broker directory: {path}")
if st.st_uid != 0 or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
    raise SystemExit(f"Unsafe broker directory ownership or mode: {path}")
PY
}

require_root_file() {
  local path="$1"
  python3 - "$path" <<'PY'
import os
import stat
import sys

path = sys.argv[1]
st = os.lstat(path)
if not stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode):
    raise SystemExit(f"Unsafe broker file: {path}")
if st.st_uid != 0 or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
    raise SystemExit(f"Unsafe broker file ownership or mode: {path}")
PY
}

install -d -m 0755 -o root -g root "$LIBEXEC_DIR" /usr/local/bin
install -d -m 0700 -o root -g root "$CACHE_DIR" "$RUN_HOME"
require_root_directory /usr/local/libexec
require_root_directory "$LIBEXEC_DIR"
require_root_directory /usr/local/bin
require_root_directory "$CACHE_DIR"
require_root_directory "$RUN_HOME"

# The source importer is copied, not executed from the agent checkout. The
# root-owned copy is the only payload the broker is allowed to run.
install -m 0644 -o root -g root "$SOURCE_IMPORTER" "$INSTALLER_IMPORTER"
install -m 0755 -o root -g root "$SOURCE_BROKER" "$INSTALLER_BROKER"
install -m 0755 -o root -g root "$SOURCE_WRAPPER" "$WRAPPER"

require_root_file "$NODE"
require_root_file "$INSTALLER_IMPORTER"
require_root_file "$INSTALLER_BROKER"
require_root_file "$WRAPPER"

# This rule has no wildcard: sudo can run only the zero-argument root-owned
# wrapper. The wrapper then executes only the fixed broker payload above.
install -d -m 0755 -o root -g root /etc/sudoers.d
cat > "$SUDOERS_FILE" <<EOF
$AGENT_USER ALL=(root) NOPASSWD: $WRAPPER
EOF
chown root:root "$SUDOERS_FILE"
chmod 0440 "$SUDOERS_FILE"
visudo -cf "$SUDOERS_FILE" >/dev/null

printf 'Installed FPL preseason broker for %s.\n' "$AGENT_USER"
printf 'Run: npm run fetch-preseason-data\n'
